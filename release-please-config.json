{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "maven",
      "package-name": "s3-wagon",
      "changelog-path": "CHANGES.md",
      "include-v-in-tag": false,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Added"
        },
        {
          "type": "fix",
          "section": "Fixed"
        },
        {
          "type": "perf",
          "section": "Changed"
        },
        {
          "type": "build",
          "section": "Changed"
        },
        {
          "type": "refactor",
          "section": "Changed",
          "hidden": true
        },
        {
          "type": "docs",
          "section": "Changed",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Changed",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "Changed",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Changed",
          "hidden": true
        }
      ],
      "extra-files": [
        "README.md",
        ".buildspec"
      ]
    }
  }
}
