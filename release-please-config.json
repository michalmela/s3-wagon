{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "maven",
      "package-name": "s3-wagon",
      "changelog-path": "CHANGES.md",
      "include-v-in-tag": false,
      "//include-component-in-tag": "Defaults to true, which tags a release s3-wagon-1.1.0 rather than 1.1.0. That silently broke the 1.1.0 release: the Release workflow triggers on tags matching [0-9]*, so it never ran and nothing reached Clojars. Plain tags also match 1.0.0 through 1.0.2 and the gitTag in .buildspec.",
      "include-component-in-tag": false,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Added"
        },
        {
          "type": "fix",
          "section": "Fixed"
        },
        {
          "type": "perf",
          "section": "Changed"
        },
        {
          "type": "build",
          "section": "Changed"
        },
        {
          "type": "refactor",
          "section": "Changed",
          "hidden": true
        },
        {
          "type": "docs",
          "section": "Changed",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Changed",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "Changed",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Changed",
          "hidden": true
        }
      ],
      "extra-files": [
        "README.md",
        ".buildspec"
      ]
    }
  }
}
