<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.michalmela</groupId>
    <artifactId>s3-wagon</artifactId>
    <version>1.1.0</version>
    <name>s3-wagon</name>
    <description>Maven wagon for S3 with support for Leiningen, the Clojure build tool.</description>

    <developers>
        <developer>
            <name>Michał Mela</name>
            <url>https://github.com/michalmela</url>
        </developer>
    </developers>

    <url>https://github.com/michalmela/s3-wagon</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The wagon is loaded into the JVM running Maven or Leiningen, so the
             artifact stays on Java 8 bytecode. Tests are free to use a modern
             baseline because they only ever run on this project's own toolchain. -->
        <maven.compiler.release>8</maven.compiler.release>
        <maven.compiler.testRelease>17</maven.compiler.testRelease>
        <aws.sdk.version>2.51.4</aws.sdk.version>
        <wagon.version>3.5.3</wagon.version>
        <junit.version>6.1.3</junit.version>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-jar-plugin.version>3.5.0</maven-jar-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
        <spotbugs-maven-plugin.version>4.10.3.0</spotbugs-maven-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>
        <maven-artifact-plugin.version>3.6.1</maven-artifact-plugin.version>
        <spotless-maven-plugin.version>2.44.5</spotless-maven-plugin.version>
        <!-- Fixed timestamp makes the jar byte-for-byte reproducible. -->
        <project.build.outputTimestamp>2026-08-11T00:00:00Z</project.build.outputTimestamp>
        <testcontainers.version>1.21.4</testcontainers.version>
        <commons-compress.version>1.28.0</commons-compress.version>
        <plexus-utils.version>4.0.3</plexus-utils.version>
        <minio.image>minio/minio:RELEASE.2025-09-07T16-13-09Z</minio.image>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Testcontainers 1.21.4 pulls commons-compress 1.24.0, which carries two
                 denial-of-service advisories fixed in 1.26.0. Testcontainers itself cannot
                 be moved off it: the minio and junit-jupiter modules have no 2.x release and
                 1.21.4 is the newest 1.x, so the transitive dependency is raised instead.
                 Test scope only - none of this reaches the published artifact. -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>${commons-compress.version}</version>
            </dependency>
            <!-- wagon-provider-api 3.5.3 - which is its latest release - brings plexus-utils
                 3.3.1, carrying a directory traversal in extractFile (CVE-2025-67030). Provided
                 scope, so Maven's own copy is what actually runs and nothing here reaches a
                 consumer; this raises what the project compiles and tests against, and stops the
                 advisory being reported against a repository that cannot ship it. 4.0.3 is both
                 the latest and what Maven 4 itself puts on the classpath; Maven 3.9.16 ships
                 3.6.1, which is also past the fix, and the end-to-end job exercises both. -->
            <dependency>
                <groupId>org.codehaus.plexus</groupId>
                <artifactId>plexus-utils</artifactId>
                <version>${plexus-utils.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <!-- The wagon always builds an ApacheHttpClient explicitly, so the
                 default HTTP client implementations would only bloat the
                 classpath of every build that loads this plugin. -->
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache5-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ssooidc</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache5-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sso</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache5-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Needed at runtime so a profile configured with role_arn/source_profile can assume
             the role; the SDK loads the STS provider reflectively. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sts</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache5-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>apache-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.wagon</groupId>
            <artifactId>wagon-provider-api</artifactId>
            <version>${wagon.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>minio</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-failsafe-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <minio.image>${minio.image}</minio.image>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>io.github.michalmela.s3wagon</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx-maven-plugin.version}</version>
                <configuration>
                    <!-- An SBOM should describe what this artifact ships. Provided dependencies
                         are supplied by whatever runs the wagon - Maven brings its own
                         plexus-utils - so listing them here overstates what consumers receive,
                         and makes a vulnerability in the host's copy look like one in ours. -->
                    <includeProvidedScope>false</includeProvidedScope>
                    <includeTestScope>false</includeTestScope>
                    <!-- Clojars only accepts .pom, .jar, .sha1, .md5, .asc, .module and .sig
                         uploads; anything else is a 400 that fails the whole deploy. The SBOM
                         still gets built and attached to the GitHub release, which is where
                         people actually look for it. -->
                    <skipAttach>true</skipAttach>
                </configuration>
                <executions>
                    <execution>
                        <id>sbom</id>
                        <phase>package</phase>
                        <goals>
                            <goal>makeAggregateBom</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin.version}</version>
                <configuration>
                    <!-- Javadoc warnings are invisible in a green build, so twenty of them
                         accumulated before anyone looked. The published API here is small enough
                         that keeping it fully documented is cheap. If a JDK upgrade introduces a
                         new doclint check and this starts failing on something not worth fixing,
                         this is one line to drop. -->
                    <failOnWarnings>true</failOnWarnings>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-maven-plugin.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <includeTests>false</includeTests>
                    <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <id>analyse</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven-source-plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-artifact-plugin</artifactId>
                <version>${maven-artifact-plugin.version}</version>
                <configuration>
                    <!-- The plugin drops javadoc by default, because for most projects it is
                         the one artifact that will not reproduce. This one does, so record it
                         and let a rebuild prove it. -->
                    <ignoreJavadoc>false</ignoreJavadoc>
                    <!-- Same reason as the SBOM above: Clojars rejects a .buildinfo upload, so
                         it rides on the GitHub release instead of the Maven repository. -->
                    <attach>false</attach>
                    <!-- Record "Unix" and a JDK major version rather than this machine's exact
                         OS build, so the buildinfo is itself reproducible. Without this it
                         would be the one attached file that never matches on a rebuild. -->
                    <reproducible>true</reproducible>
                </configuration>
                <executions>
                    <execution>
                        <!-- Records the toolchain and a checksum per artifact, so anyone can
                             rebuild and prove they got the same bytes. Generated on every
                             verify rather than only on release, so a change that breaks
                             reproducibility shows up in CI instead of at publish time. -->
                        <id>buildinfo</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>buildinfo</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <configuration>
                    <java>
                        <!-- Wider than the default source roots: this project also keeps benchmark,
                             fuzz and runtime-check sources under src/, and they are code too. -->
                        <includes>
                            <include>src/*/java*/**/*.java</include>
                        </includes>
                        <eclipse>
                            <file>${project.basedir}/.eclipse-format.prefs</file>
                        </eclipse>
                        <removeUnusedImports>
                            <!-- The default engine is google-java-format, which cannot run on this
                                 project's JDK; this one parses with JavaParser instead. -->
                            <engine>cleanthat-javaparser-unnecessaryimport</engine>
                        </removeUnusedImports>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                    <formats>
                        <!-- Everything else that is text under version control: no opinion about
                             its content, only that it does not carry trailing whitespace and does
                             end with a newline. -->
                        <format>
                            <includes>
                                <include>*.md</include>
                                <include>.github/**/*.yml</include>
                                <include>mise-tasks/**</include>
                                <include>mise.toml</include>
                                <include>.buildspec</include>
                            </includes>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </format>
                    </formats>
                </configuration>
                <executions>
                    <execution>
                        <!-- Bound to verify rather than validate so an ordinary mvn test stays
                             fast; CI runs verify, so nothing unformatted reaches master. -->
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Signing is only wanted when publishing, so it stays out of ordinary builds. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <configuration>
                            <!-- There is no tty on a CI runner, so gpg has to take the
                                 passphrase from MAVEN_GPG_PASSPHRASE rather than prompting.
                                 Without loopback pinentry it hangs and then fails. -->
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <scm>
        <connection>scm:git:git://github.com/michalmela/s3-wagon.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/michalmela/s3-wagon.git</developerConnection>
        <url>https://github.com/michalmela/s3-wagon</url>
    </scm>

    <licenses>
        <license>
            <name>The MIT License (MIT)</name>
            <url>http://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <distributionManagement>
        <repository>
            <id>clojars</id>
            <name>Clojars repository</name>
            <url>https://clojars.org/repo</url>
        </repository>
    </distributionManagement>
</project>
